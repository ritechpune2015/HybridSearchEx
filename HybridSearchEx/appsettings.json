{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "OpenAI": {
    "BaseUrl": "https://api.openai.com/v1/",
    "EmbeddingModel": "text-embedding-3-small",
    "Dimensions": 1536,
    "ApiKey": "xxxxxxxxx"
  },
  "Qdrant": {
    "BaseUrl": "http://localhost:6333",
    "CollectionName": "hybrid_documents",
    "DenseVectorName": "dense",
    "SparseVectorName": "bm25",
    "DenseVectorDimensions": 1536
  },

  "HybridSearch": {
    "DenseCandidateLimit": 50,
    "SparseCandidateLimit": 50,
    "FinalResultLimit": 10
  },
  "DocumentProcessing": {
    "ChunkSize": 1200,
    "ChunkOverlap": 200,
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [
      ".txt",".pdf"
    ]
  }

}
